[Unit]
Description=StudySync ML Server
After=network.target

[Service]
User=geo
WorkingDirectory=/home/geo/proiect-inginerie-software-cfc/ml-server
# Environment="EMBEDDER_MODEL=qwen3-vl"
# Environment="RERANKER_MODEL=qwen3-vl"
ExecStart=/home/geo/proiect-inginerie-software-cfc/ml-server/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target
