# StudySync App Configuration
server {
    listen 80;
    server_name www.retelecfc.systems;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    server_name www.retelecfc.systems;

    ssl_certificate /etc/letsencrypt/live/www.retelecfc.systems/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.retelecfc.systems/privkey.pem;

    root /home/geo/proiect-inginerie-software-cfc/studysync-frontend/dist/studysync-frontend/browser;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://localhost:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Proxy WebSocket connections
    location /ws/ {
        proxy_pass http://localhost:8080/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
